{
  "name": "ysz-harness",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "vite build && tsx src/main.ts",
    "bug": "tsx src/bug.ts",
    "dashboard": "open \"http://localhost:${PORT:-4000}/?token=$(cat data/dashboard-token)\"",
    "test": "node --import tsx --test \"test/**/*.test.ts\"",
    "test:contract": "node --import tsx --test test/beads.contract.ts",
    "typecheck": "tsc --noEmit",
    "images": "for f in images/*.Dockerfile; do docker build -f \"$f\" -t \"ysz-harness/$(basename \"$f\" .Dockerfile)\" images || exit 1; done",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@ai-hero/sandcastle": "0.12.0",
    "driver.js": "1.8.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "recharts": "3.10.1",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "patch-package": "^8.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.3"
  }
}
